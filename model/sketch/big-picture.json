    { "id": "f49f8857-c60e-4fa3-b751-28e7ffcde12c", "kind": "policy", "text": "Only a copy on the shelf can be reserved", "sections": [{ "label": "Rule", "type": "text", "text": "No waiting line for books that are out." }] },
